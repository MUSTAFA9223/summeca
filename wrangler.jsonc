{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "summeca",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-06",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "keep_vars": true,
  "vars": {
    "NEXT_PUBLIC_SUPABASE_URL": "https://encrvihpdkvubxyvphlt.supabase.co",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY": "sb_publishable_4RjLGxEWw60q2Wyvre_fWg_2wGWiGKA",
    "NEXT_PUBLIC_SITE_URL": "https://summeca.com"
  },
  "routes": [
    {
      "pattern": "summeca.com/*",
      "zone_name": "summeca.com"
    }
  ],
  "assets": {
    "directory": "dist",
    "binding": "ASSETS"
  },
  "ai": {
    "binding": "AI"
  },
  "observability": {
    "enabled": true
  }
}
