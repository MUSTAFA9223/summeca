{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "summeca",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-06",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "routes": [
    {
      "pattern": "summeca.com/*",
      "zone_name": "summeca.com"
    }
  ],
  "assets": {
    "directory": "dist",
    "binding": "ASSETS"
  },
  "ai": {
    "binding": "AI"
  },
  "observability": {
    "enabled": true
  }
}
